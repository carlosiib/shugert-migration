---
import Badge from "@components/ui/badge.astro";
import { Picture } from "astro:assets";
import FeatureImg1 from "../assets/shugert/custom-machine-learning.png";
import FeatureImg2 from "../assets/features/2.png";
import { Icon } from "astro-icon/components";
import Link from "@components/ui/link.astro";

const { nomargin } = Astro.props;
---

<section
  class="flex flex-col items-stretch justify-center text-center md:mt-4 md:pt-4"
>
  <h1 class="text-md mb-2 font-semibold tracking-tight text-black">
    MARKETING ANALYTICS & DATA SCIENCE
  </h1>
  <h2 class="my-6 text-4xl font-extrabold text-gray-800">
    Shugert Marketing & Analytics
  </h2>

  <p>Digital Marketing, E-commerce & Data Science rule our world!</p>

  <p class="my-4 text-lg text-gray-700">
    We are an ecommerce and digital marketing agency anchored in tradition and
    deeply invested in the future of digital commerce. We are online retail
    experts that specialize in B2C and B2B implementations. We are a Google
    Certified Partner digital advertising agency specializing in data-driven
    target audience identification and delivery for multi-device, multi-channel
    campaigns: SEO/SEM, targeted display advertising, email marketing, and
    social media advertising.
  </p>

  <p class="text-lg text-gray-700">
    Our team of marketing data scientist make sense of your data overload and
    bring you actionable insights from your guests. We’re focused on bringing
    your business value and revenue, not just vanity metrics and empty numbers.
  </p>
</section>
