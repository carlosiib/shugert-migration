<section
  class="bg-gradient-to-br from-[#30e9be4d] to-[#15bcdf4d] p-2 py-6 md:p-0 md:py-48"
  aria-labelledby="contact-section"
>
  <div class="mx-auto flex max-w-7xl flex-col gap-10 md:flex-row">
    <div class="md:max-w-2/3">
      <h2
        id="contact-section"
        class="text-5xl font-extrabold text-gray-800 md:leading-24 lg:text-7xl"
      >
        Contact us now to improve your Shopify store
      </h2>
      <p class="mt-3 text-lg text-gray-700 lg:text-xl">
        Increase brand awareness, drive traffic, and generate leads or sales
        through strategic use of our unique and proprietary machine learning
        tools. If you have any questions, please do not hesitate to contact us
        directly.
      </p>
      <div class="mt-5">
        <div class="items-center space-x-2 text-gray-700">
          <div class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="30"
              height="30"
              viewBox="0 0 30 30"
              fill="none"
              aria-hidden="true"
            >
              <path
                fill="#3282b8"
                fill-rule="evenodd"
                clip-rule="evenodd"
                d="M7.57538 6.07391C11.6759 1.97341 18.3241 1.97341 22.4246 6.07391C26.5251 10.1744 26.5251 16.8227 22.4246 20.9232L15 28.3478L7.57538 20.9232C3.47487 16.8227 3.47487 10.1744 7.57538 6.07391ZM15 16.4985C16.6569 16.4985 18 15.1554 18 13.4985C18 11.8417 16.6569 10.4985 15 10.4985C13.3431 10.4985 12 11.8417 12 13.4985C12 15.1554 13.3431 16.4985 15 16.4985Z"
                fill="#E5ABF3"></path>
            </svg>
            <span class="text-lg font-bold lg:text-xl">Our locations</span>
          </div>
          <div class="pl-10">
            <p class="text-lg lg:text-xl">* West New York, NJ</p>
            <p class="text-lg lg:text-xl">* Barcelona, Spain</p>
          </div>
        </div>
        <div class="mt-4 items-center space-x-2 text-gray-700">
          <div class="flex items-center gap-2">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="30"
              height="30"
              viewBox="0 0 30 30"
              fill="none"
              aria-hidden="true"
            >
              <path
                fill="#3282b8"
                d="M3.005 8.82387L14.9999 14.8213L26.995 8.82379C26.9045 7.24826 25.5982 5.99854 24 5.99854H6C4.40178 5.99854 3.09545 7.2483 3.005 8.82387Z"
                fill="#E5ABF3"></path>
              <path
                fill="#3282b8"
                d="M27 12.1754L14.9999 18.1754L3 12.1755V20.9985C3 22.6554 4.34315 23.9985 6 23.9985H24C25.6569 23.9985 27 22.6554 27 20.9985V12.1754Z"
                fill="#E5ABF3"></path>
            </svg>
            <span class="text-lg font-bold lg:text-xl">Send us an email</span>
          </div>
          <div class="pl-10">
            <a
              class="text-lg hover:underline lg:text-xl"
              href="mailto:hello@shugert.com.mx"
              aria-label="Send an email to hello@shugert.com.mx"
            >
              hello@shugert.com.mx
            </a>
          </div>
        </div>
      </div>
    </div>
    <div class="w-full rounded-xl bg-white p-5 md:p-8">
      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        id="form"
        class="[&>*]:my-6"
        data-astro-reload
        novalidate
        aria-labelledby="form-title"
      >
        <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
        <input
          type="checkbox"
          class="hidden"
          style="display:none"
          name="botcheck"
          aria-hidden="true"
        />

        <h2 id="form-title" class="text-2xl font-bold text-gray-800">
          Send us a message
        </h2>

        <div class="mb-5">
          <label for="name" class="sr-only">Your Name</label>
          <input
            id="name"
            type="text"
            placeholder="Your Name"
            required
            class="w-full rounded-4xl border border-gray-300 px-4 py-3 font-bold ring-gray-100 outline-none placeholder:text-gray-500 focus:border-gray-600 focus:ring-4"
            name="name"
            aria-required="true"
          />
          <div
            class="empty-feedback invalid-feedback mt-1 text-sm text-red-400"
          >
            Please provide your full name.
          </div>
        </div>

        <div class="mb-5">
          <label for="email_address" class="sr-only">Your Email</label>
          <input
            id="email_address"
            type="email"
            placeholder="Your Email"
            name="email"
            required
            class="w-full rounded-4xl border border-gray-300 px-4 py-3 font-bold ring-gray-100 outline-none placeholder:text-gray-500 focus:border-gray-600 focus:ring-4"
            aria-required="true"
          />
          <div class="empty-feedback mt-1 text-sm text-red-400">
            Please provide your email address.
          </div>
          <div class="invalid-feedback mt-1 text-sm text-red-400">
            Please provide a valid email address.
          </div>
        </div>

        <div class="mb-3">
          <label for="message" class="sr-only">Your Message</label>
          <textarea
            id="message"
            name="message"
            required
            placeholder="Write Your Message Here..."
            class="h-36 w-full rounded-4xl border border-gray-300 p-4 font-bold ring-gray-100 outline-none placeholder:text-gray-500 focus:border-gray-600 focus:ring-4"
            aria-required="true"></textarea>
          <div
            class="empty-feedback invalid-feedback mt-1 text-sm text-red-400"
          >
            Please enter your message.
          </div>
        </div>

        <button
          class="group relative inline-flex h-14 w-full items-center justify-center overflow-hidden rounded-4xl bg-[#3282b8] font-semibold shadow-md hover:shadow-lg focus:ring-2 focus:ring-blue-300"
          aria-label="Send Message"
          type="submit"
        >
          <div
            class="inline-flex h-14 translate-y-0 items-center justify-center px-8 text-lg text-white transition-transform duration-500 group-hover:-translate-y-[150%]"
          >
            Send Message
          </div>
          <div
            class="absolute inline-flex h-14 w-full translate-y-[100%] items-center justify-center text-neutral-50 transition-transform duration-500 group-hover:translate-y-0"
          >
            <span
              class="absolute h-full w-full translate-y-full scale-y-0 skew-y-4 bg-black transition-transform duration-500 group-hover:translate-y-0 group-hover:scale-150"
            ></span>
            <span class="z-10 text-lg">Send Message</span>
          </div>
        </button>

        <div
          id="result"
          class="mt-3 text-center"
          role="status"
          aria-live="polite"
        >
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .is-invalid,
  .was-validated :invalid {
    border-color: #dc3545;
  }
</style>

<script is:inline>
  document.addEventListener(
    "astro:page-load",
    () => {
      const form = document.getElementById("form");
      const result = document.getElementById("result");

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        form.classList.add("was-validated");
        if (!form.checkValidity()) {
          form.querySelectorAll(":invalid")[0].focus();
          return;
        }
        const formData = new FormData(form);
        const object = Object.fromEntries(formData);
        const json = JSON.stringify(object);

        result.innerHTML = "Sending...";

        fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: json,
        })
          .then(async (response) => {
            let json = await response.json();
            if (response.status == 200) {
              result.classList.add("text-green-500");
              result.innerHTML = json.message;
            } else {
              console.log(response);
              result.classList.add("text-red-500");
              result.innerHTML = json.message;
            }
          })
          .catch((error) => {
            console.log(error);
            result.innerHTML = "Something went wrong!";
          })
          .then(function () {
            form.reset();
            form.classList.remove("was-validated");
            setTimeout(() => {
              result.style.display = "none";
            }, 5000);
          });
      });
    },
    { once: true }
  );
</script>
