---
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";
---

<Layout title="Our Work">
  <Container>
    <div class="rounded-xl bg-white p-8 text-center shadow-lg">
      <h1 class="mb-4 text-3xl font-bold text-gray-800">
        🚧 Under Construction 🚧
      </h1>
      <p class="text-gray-600">
        We're working hard to bring you something amazing. Stay tuned!
      </p>
      <div class="mt-6">
        <a
          href="/"
          class="rounded-full bg-indigo-600 px-4 py-2 text-white transition hover:bg-indigo-700"
        >
          Go Back Home
        </a>
      </div>
    </div>
  </Container>
</Layout>
