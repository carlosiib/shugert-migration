---
import icon1 from "../assets/shugert/Lead_scoring_icon.png";
import icon2 from "../assets/shugert/Customer_Churn_Icon.png";
import icon3 from "../assets/shugert/Behavior_Analysis_icon.png";
import icon4 from "../assets/shugert/Predictive_Analysis_icon.png";
import { Picture } from "astro:assets";

const benefitsExplained = [
  {
    src: icon1,
    title: "Lead Scoring",
    text: "We improve conversion rates of sales based on a lead rating predictive algorithm.",
  },
  {
    src: icon2,
    title: "Reduce Customer Churn",
    text: "We analyze and significantly reduce customer churn to streamline risk prediction and intervention models.",
  },
  {
    src: icon3,
    title: "Customer Behavior Analysis",
    text: "We identify and define the sales projections of specific customer segments and microsegments.",
  },
  {
    src: icon4,
    title: "Predictive Analytics",
    text: "We turn your data into insights that helps you make better decisions and improve your business.",
  },
];
---

<div>
  <div class="my-10 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4">
    {
      benefitsExplained.map((benefitExplained, index) => (
        <div class="flex flex-col items-center p-6 text-center">
          <Picture
            src={benefitExplained.src}
            alt={benefitExplained.title || `Card image ${index + 1}`}
            class="h-auto max-w-sm object-contain"
            loading="lazy"
          />
          <h3 class="mb-4 text-xl font-bold text-gray-800">
            {benefitExplained.title}
          </h3>
          <p class="text-gray-600">{benefitExplained.text}</p>
        </div>
      ))
    }
  </div>
</div>
