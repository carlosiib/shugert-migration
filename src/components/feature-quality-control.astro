---
import Container from "@components/container.astro";
import Review from "@components/review.astro";
import Badge from "./ui/badge.astro";
import Picture from "astro/components/Picture.astro";
import icon1 from "../assets/shugert/Paso1.png";
import icon2 from "../assets/shugert/Paso2.png";
import icon3 from "../assets/shugert/Paso3.png";
import icon4 from "../assets/shugert/Paso4.png";
import icon5 from "../assets/shugert/Paso5.png";
---

<Container>
  <div class="mt-24 text-center">
    <Badge color="blue"
      >A GOOD PRODUCTION PROCESS MAKES FOR BETTER QUALITY CONTROL</Badge
    >
    <h2 class="text-center text-4xl font-black lg:text-5xl lg:tracking-tight">
      Our typical <span class="text-[color:--primary-color]"
        >custom process</span
      > consists of:
    </h2>
  </div>
</Container>

<div class="relative mt-10 overflow-x-clip">
  <div>
    <h2 class="text-center text-slate-500">
      Trusted by popular startups you know
    </h2>
    <div
      class="mt-6 flex flex-wrap items-center justify-center gap-x-1 gap-y-4"
    >
      <div class="my-2 w-11/12 min-w-[200px] text-gray-500 md:w-1/2 lg:w-1/6">
        <div class="mb-3 flex h-[150px] items-center justify-center">
          <Picture
            src={icon1}
            alt="Feature Image"
            formats={["avif", "webp"]}
            loading="lazy"
          />
        </div>
        <div class="mt-2 flex gap-x-2">
          <span class="font-bold">01.</span>
          <span class="font-bold">Initial Research</span>
        </div>
        <p>
          We learn all about what your company is about including your long term
          goals and challenges.
        </p>
      </div>
      <div class="my-2 w-11/12 min-w-[200px] text-gray-500 md:w-1/2 lg:w-1/6">
        <div class="mb-3 flex h-[150px] items-center justify-center">
          <Picture
            src={icon2}
            alt="Feature Image"
            formats={["avif", "webp"]}
            loading="lazy"
          />
        </div>
        <div class="mt-2 flex gap-x-2">
          <span class="font-bold">01.</span>
          <span class="font-bold">Initial Research</span>
        </div>
        <p>
          We learn all about what your company is about including your long term
          goals and challenges.
        </p>
      </div>
      <div class="my-2 w-11/12 min-w-[200px] text-gray-500 md:w-1/2 lg:w-1/6">
        <div class="mb-3 flex h-[150px] items-center justify-center">
          <Picture
            src={icon3}
            alt="Feature Image"
            formats={["avif", "webp"]}
            loading="lazy"
          />
        </div>
        <div class="mt-2 flex gap-x-2">
          <span class="font-bold">01.</span>
          <span class="font-bold">Initial Research</span>
        </div>
        <p>
          We learn all about what your company is about including your long term
          goals and challenges.
        </p>
      </div>
      <div class="my-2 w-11/12 min-w-[200px] text-gray-500 md:w-1/2 lg:w-1/6">
        <div class="mb-3 flex h-[150px] items-center justify-center">
          <Picture
            src={icon4}
            alt="Feature Image"
            formats={["avif", "webp"]}
            loading="lazy"
            class="flex justify-center object-contain"
          />
        </div>
        <div class="mt-2 flex gap-x-2">
          <span class="font-bold">01.</span>
          <span class="font-bold">Initial Research</span>
        </div>
        <p>
          We learn all about what your company is about including your long term
          goals and challenges.
        </p>
      </div>
      <div class="my-2 w-11/12 min-w-[200px] text-gray-500 md:w-1/2 lg:w-1/6">
        <div class="mb-3 flex h-[150px] items-center justify-center">
          <Picture
            src={icon5}
            alt="Feature Image"
            formats={["avif", "webp"]}
            loading="lazy"
            class=""
          />
        </div>
        <div class="mt-2 flex gap-x-2">
          <span class="font-bold">01.</span>
          <span class="font-bold">Initial Research</span>
        </div>
        <p>
          We learn all about what your company is about including your long term
          goals and challenges.
        </p>
      </div>
    </div>
  </div>
</div>
