---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { Picture } from "astro:assets";

// Generate a new path for every collection entry
export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the entry directly from the prop on render
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={entry.data.title}>
  <Container>
    <div class="mx-auto mt-14 max-w-3xl text-center">
      <span class="text-sm font-medium tracking-wider text-blue-400 uppercase">
        {entry.data.category}
      </span>
      <h1
        class="mt-1 text-3xl font-bold lg:text-4xl lg:leading-tight lg:tracking-tight"
      >
        {entry.data.title}
      </h1>
      <div
        class="mt-3 flex flex-wrap items-center justify-center gap-2 text-sm md:flex-nowrap"
      >
        <span class="text-slate-400">•</span>
        <time
          class="text-slate-400"
          datetime={entry.data.publishDate.toISOString()}
        >
          {entry.data.publishDate.toDateString()}
        </time>
        <span class="hidden text-slate-400 md:block">•</span>
        <div class="flex w-full flex-wrap justify-center gap-3 md:w-auto">
          {
            entry.data.tags.map((tag) => (
              <span class="text-sm text-slate-500">#{tag}</span>
            ))
          }
        </div>
      </div>
    </div>

    {
      entry.data.image.src && (
        <div class="mx-auto max-w-4xl">
          <Picture
            formats={["avif", "webp"]}
            src={entry.data.image.src}
            alt="Feature image"
            width="1280"
            height="800"
            class="mt-6 h-full w-full rounded-xl object-contain"
            transition:name={`post-img-${entry.slug}`}
          />
        </div>
      )
    }

    <div class="markdownstyles mx-auto mt-6 max-w-3xl">
      <Content />

      <hr />
      <div class="flex justify-between">
        {
          entry.data.prev && (
            <a href={entry.data.prev.url} class="text-left hover:underline">
              <p>← Previous Post:</p>
              <br />
              <p>{entry.data.prev.title}</p>
            </a>
          )
        }
        {
          entry.data.next.url && (
            <a href={entry.data.next.url} class="text-right hover:underline">
              <p>Next Post: →</p>
              <br />
              <p>{entry.data.next.title} </p>
            </a>
          )
        }
      </div>
      <hr />
    </div>

    <div class="mt-12 text-center">
      <a
        href="/blog"
        class="rounded-md bg-gray-100 px-5 py-3 transition hover:bg-gray-200"
        >← Back to Blog</a
      >
    </div>
  </Container>
</Layout>
