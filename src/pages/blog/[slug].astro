---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import { Picture } from "astro:assets";

import Contactform from "@components/contactform.astro";

export async function getStaticPaths() {
  const blogEntries = await getCollection("blog");
  return blogEntries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout
  title={entry.data.title}
  description={`Read more about ${entry.data.title}`}
  footerMargin={false}
>
  <Container>
    <article class="mb-10">
      <header class="mx-auto mt-14 max-w-3xl text-center">
        <span
          class="text-sm font-medium tracking-wider text-blue-400 uppercase"
        >
          {entry.data.category}
        </span>
        <h1
          class="mt-1 text-3xl font-bold lg:text-4xl lg:leading-tight lg:tracking-tight"
        >
          {entry.data.title}
        </h1>
        <div
          class="mt-3 flex flex-wrap items-center justify-center gap-2 text-sm md:flex-nowrap"
        >
          <span class="text-slate-400">•</span>
          <time
            class="text-slate-400"
            datetime={entry.data.publishDate.toISOString()}
          >
            {entry.data.publishDate.toDateString()}
          </time>
          <span class="hidden text-slate-400 md:block">•</span>
          <div class="flex w-full flex-wrap justify-center gap-3 md:w-auto">
            {
              entry.data.tags.map((tag) => (
                <a
                  href={`/blog/tag/${tag}`}
                  class="text-sm text-slate-500 hover:underline"
                >
                  #{tag}
                </a>
              ))
            }
          </div>
        </div>
      </header>

      <section class="flex flex-col md:gap-8 lg:flex-row">
        <div class="lg:max-w-2/3">
          {
            entry.data.image.src && (
              <div class="mx-auto max-w-4xl">
                <Picture
                  formats={["avif", "webp"]}
                  src={entry.data.image.src}
                  alt={entry.data.image.alt || "Feature image"}
                  width="1280"
                  height="800"
                  class="mt-6 h-full w-full rounded-xl object-contain"
                  transition:name={`post-img-${entry.slug}`}
                />
              </div>
            )
          }

          <div class="markdownstyles mx-auto mt-6 max-w-3xl">
            <Content />

            <hr />
            <nav class="flex justify-between">
              {
                entry.data.prev && (
                  <a
                    href={entry.data.prev.url}
                    class="text-left hover:underline"
                  >
                    <p>← Previous Post:</p>
                    <br />
                    <p>{entry.data.prev.title}</p>
                  </a>
                )
              }
              {
                entry.data.next.url && (
                  <a
                    href={entry.data.next.url}
                    class="text-right hover:underline"
                  >
                    <p>Next Post: →</p>
                    <br />
                    <p>{entry.data.next.title} </p>
                  </a>
                )
              }
            </nav>
            <hr />
          </div>

          <footer class="mt-12 text-center">
            <a
              href="/blog"
              class="rounded-md bg-gray-100 px-5 py-3 transition hover:bg-gray-200"
              >← Back to Blog</a
            >
          </footer>
        </div>

        <aside class="mt-4 lg:max-w-1/3">
          <!-- Search -->
          <!-- <div class="mb-6">
            <input
              type="text"
              placeholder="Type to search..."
              class="w-full rounded-3xl border border-gray-300 p-6"
            />
          </div> -->

          <!-- Recent Posts -->
          <section class="mb-6 rounded-3xl border p-6">
            <h2 class="mb-4 text-2xl font-bold text-gray-800">Recent Posts</h2>
            <ul>
              {
                (
                  await (await getCollection("blog"))
                    .sort(
                      (a, b) =>
                        b.data.publishDate.valueOf() -
                        a.data.publishDate.valueOf()
                    )
                    .slice(0, 10)
                ).map((post) => (
                  <li>
                    <a
                      href={`/blog/${post.slug}`}
                      class="text-xl leading-relaxed text-gray-700 transition-colors hover:text-blue-500"
                    >
                      {post.data.title}
                    </a>
                    <hr class="my-2 border-t-1 border-gray-200" />
                  </li>
                ))
              }
            </ul>
          </section>

          <!-- Company -->
          <section class="mb-6 rounded-3xl border p-6">
            <h2 class="mb-4 text-2xl font-bold text-gray-800">Company</h2>
            <ul>
              <li>
                <a
                  href="/about"
                  class="text-xl leading-relaxed text-gray-700 transition-colors hover:text-blue-500"
                  >About</a
                >
              </li>
              <hr class="my-2 border-t-1 border-gray-200" />
              <li>
                <a
                  href="/our-services"
                  class="text-xl leading-relaxed text-gray-700 transition-colors hover:text-blue-500"
                  >Services</a
                >
              </li>
            </ul>
          </section>

          <!-- Categories -->
          <section class="mb-6 rounded-3xl border p-6">
            <h2 class="mb-4 text-2xl font-bold text-gray-800">Categories</h2>
            <ul>
              {
                Object.entries(
                  (await getCollection("blog")).reduce((acc, post) => {
                    post.data.category in acc
                      ? acc[post.data.category]++
                      : (acc[post.data.category] = 1);
                    return acc;
                  }, {})
                ).map(([category, count]) => (
                  <li class="text-xl leading-relaxed text-gray-700 transition-colors hover:text-blue-500">
                    <a
                      href={`/blog/category/${category}`}
                      class="hover:underline"
                    >
                      {category} ({count})
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>

          <!-- Tags -->
          <section class="mb-6 rounded-3xl border p-6">
            <h2 class="mb-4 text-2xl font-bold text-gray-800">Popular Tags:</h2>
            <ul class="flex flex-wrap gap-2">
              {
                Array.from(
                  new Set(
                    (await getCollection("blog"))
                      .map((post) => post.data.tags)
                      .flat()
                  )
                ).map((tag) => (
                  <li class="min-w-2/12 rounded-3xl border p-2 text-center font-bold transition-colors hover:bg-[#3282b8]">
                    <a href={`/blog/tag/${tag}`} class="text-md text-gray-700">
                      {tag}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>

          <!-- Newsletter -->
          <section
            class="mb-6 rounded-3xl bg-[#0F0C20] p-8 font-semibold text-white"
          >
            <h2 class="text-2xl font-bold">Subscribe to our Newsletter</h2>
            <form action="/subscribe" method="POST">
              <input
                type="email"
                name="email"
                placeholder="Enter your email address"
                class="my-4 w-full rounded-4xl border border-gray-300 p-4"
                required
              />
              <button
                type="submit"
                class="w-full rounded-4xl bg-[#E5ABF3] p-4 text-black transition hover:bg-white"
              >
                Subscribe Now
              </button>
            </form>
          </section>
        </aside>
      </section>
    </article>
  </Container>

  <Contactform />
</Layout>
