---

<Layout
  title="About Us"
  description="Learn more about Shugert, our achievements, and the services we offer. Discover why we are leaders in Shopify development, digital marketing, and more."
  footerMargin={false}
>
  <Container>
    <section class="flex flex-col items-stretch md:m-4 md:flex-row md:p-4">
      <div class="place-self-center md:p-5">
        <h1 class="text-5xl font-bold lg:text-7xl">
          We produce creative content & concrete results
        </h1>
        <p class="mt-4 max-w-xl text-lg text-black lg:text-xl">
          We are a family of creators, graphic designers, writers, illustrators,
          coders, animators, data scientists, digital marketing specialists, and
          content generators. We create storytelling designed for your business
          and a focused digital marketing strategy: this is the compass to find
          your audience.
        </p>
      </div>
      <div class="mt-10 place-self-center md:mt-0">
        <Picture
          src={AboutUsBanner}
          alt="About Us Shugert Banner"
          formats={["avif", "webp"]}
          loading="eager"
          class="h-auto lg:max-w-xl"
        />
      </div>
    </section>
  </Container>

  <div class="mt-20 flex items-center justify-center bg-[#BBE1FA] p-8">
    <Container>
      <section class="flex flex-col items-stretch md:m-4 md:flex-row md:p-4">
        <div class="group place-self-center md:mt-0">
          <Picture
            src={AboutUsEyeClosed}
            alt="About Us Shugert Eye Closed"
            formats={["avif", "webp"]}
            loading="eager"
            class="block h-auto group-hover:hidden lg:max-w-xl"
          />
          <Picture
            src={AboutUsEyeOpen}
            alt="About Us Shugert Eye Open"
            formats={["avif", "webp"]}
            loading="eager"
            class="hidden h-auto group-hover:block lg:max-w-xl"
          />
        </div>
        <div class="mt-10 place-self-center md:mt-0 md:p-5">
          <h1 class="text-md mb-4 font-semibold tracking-tight text-black">
            What do we do?
          </h1>
          <h1 class="text-2xl font-bold tracking-tight text-black">
            Platform, content & distribution
          </h1>
          <p class="mx-auto mt-4 max-w-md text-lg text-black/70">
            One solid streamlined process that starts with a stable, fast and
            responsive website, a creative team on high quality custom content
            and a dedicated team for distribution, SEO/ SEM, organic growth,
            newsletters, etc…. the whole thing.
          </p>
          <div class="mt-5 flex">
            <Link href="/portfolio" aria-label="Explore Shugert's portfolio"
              >Explore our capabilities</Link
            >
          </div>
        </div>
      </section>
    </Container>
  </div>

  <Container>
    <section class="flex flex-col items-stretch md:m-4 md:p-4">
      <div class="mt-10 w-full md:mt-0 md:p-5">
        <div>
          <h1 class="text-md mb-4 font-semibold tracking-tight text-black">
            Awards & achievements
          </h1>
          <h1 class="text-2xl font-bold tracking-tight text-black">
            Setting standards others follow
          </h1>
        </div>
        <div class="mt-10">
          <h1 class="text-3xl font-bold tracking-tight text-black md:text-4xl">
            2022 Awards and Recognitions
          </h1>
          <ul>
            {
              Awards.Recent.map((award) => (
                <li class="my-2">
                  <p>
                    {award.text && <span>{award.text} - </span>}
                    <a
                      href={award.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-blue-500 hover:underline"
                    >
                      {award.urlText}
                    </a>
                  </p>
                </li>
              ))
            }
          </ul>
          <h1 class="mt-5 text-2xl font-bold tracking-tight text-black">
            Past Awards
          </h1>
          <ul>
            {
              Awards.Past.map((award) => (
                <li class="my-2">
                  <p>
                    {award.text && <span>{award.text} - </span>}
                    <a
                      href={award.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-blue-500 hover:underline"
                    >
                      {award.urlText}
                    </a>
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="flex flex-col items-stretch md:m-4 md:p-4">
      <div class="mt-10 w-full md:mt-0 md:p-5">
        <div>
          <h1 class="text-md mb-4 font-semibold tracking-tight text-black">
            Best. In. Town.
          </h1>
          <h1 class="text-2xl font-bold tracking-tight text-black">
            Our Services
          </h1>
        </div>
        <div class="mx-auto mt-12 grid gap-10 md:grid-cols-3">
          {
            ThingsShuter.map((ThingShugert, index) => (
              <div class="group">
                <div class="aspect-square w-full">
                  <Picture
                    src={ThingShugert}
                    alt={`Shugert service image ${index + 1}`}
                    loading="lazy"
                    width={400}
                    height={400}
                    formats={["avif", "webp"]}
                    class="h-full w-full rounded bg-white object-cover transition group-hover:-translate-y-1 group-hover:shadow-xl"
                  />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>
  </Container>
</Layout>
