---
import Link from "./ui/link.astro";
---

<div
  class="mt-20 flex flex-col items-center bg-gradient-to-bl from-indigo-900 to-indigo-700 p-8 text-center md:px-20 md:py-20"
>
  <h2 class="text-4xl tracking-tight text-white md:text-6xl">
    Ready to improve your social media engagement?
  </h2>
  <p class="mt-4 text-lg text-white/70 md:text-xl">
    Get free social media analysis. No credit card required.
  </p>
  <div class="mt-6 flex justify-center space-x-4 md:justify-start">
    <a href="/contact" aria-label="View Our Services" class="cursor-pointer">
      <button
        class="group relative inline-flex h-14 items-center justify-center overflow-hidden rounded-4xl bg-white font-semibold shadow-md hover:shadow-lg focus:ring-2 focus:ring-gray-300"
      >
        <div
          class="inline-flex h-14 translate-y-0 items-center justify-center px-8 text-lg text-black transition-transform duration-500 group-hover:-translate-y-[150%]"
        >
          Free Consultation
        </div>
        <div
          class="absolute inline-flex h-14 w-full translate-y-[100%] items-center justify-center text-neutral-50 transition-transform duration-500 group-hover:translate-y-0"
        >
          <span
            class="absolute h-full w-full translate-y-full scale-y-0 skew-y-10 bg-[#044080] transition-transform duration-500 group-hover:translate-y-0 group-hover:scale-150"
          ></span>
          <span class="z-10 text-lg">Let's go</span>
        </div>
      </button>
    </a>

    <a
      href="https://clients.shugert.com.mx/"
      aria-label="Create a Free Account"
    >
      <button
        class="group relative h-14 items-center justify-center rounded-4xl bg-white font-semibold shadow-md hover:bg-gray-100 hover:shadow-lg focus:ring-2 focus:ring-gray-300"
      >
        <div
          class="inline-flex items-center justify-center px-8 text-lg text-gray-700"
        >
          Create a Free Account
        </div>
      </button>
    </a>
  </div>
</div>
