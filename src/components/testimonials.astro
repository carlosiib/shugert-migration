---
import Container from "@components/container.astro";
import Review from "@components/review.astro";

const testimonials = [
  {
    name: "The Shops @Go Your Own Way",
    title: "",
    image: "https://images.unsplash.com/photo-1624298357597-fd92dfbec01d?w=640",
    text: "I picked TaskerArmy because they were the only ones among the candidates to provide choices over and above the requested work. This clued me in that they already knew exactly what to do. Their attention was focused on the problem and not on their qualifications, which is always a good sign.",
  },
  {
    name: "Caffé-Select",
    title: "",
    image: "https://images.unsplash.com/photo-1607746882042-944635dfe10e?w=640",
    text: "TaskerArmy has done excellent work for us! Not only did he make the required changes but created detailed instructions with pictures on how to use the feature he installed on our website. We would not hesitate to recommend TaskerArmy!",
  },
  {
    name: "40 Colori",
    title: "",
    image: "https://images.unsplash.com/photo-1639149888905-fb39731f2e6c?w=640",
    text: "Easiest and smoothest interaction to date with a Shopify Expert! I told TaskerArmy what I needed and TaskerArmy got it done quicker than I could have imagined. I gave some feedback and the same day he acted on it and fixed it with no shaming me!",
  },
  {
    name: "Wicked Thrift & PopRock Vintage",
    title: "",
    image: "https://images.unsplash.com/photo-1586297135537-94bc9ba060aa?w=640",
    text: "I have hired TaskerArmy for several tweaks to my website and online store, over the last four months. Very fast, excellent communication, totally understood my needs each time. It’s so nice to have someone you can depend on to stick with a job until completed and who really wants to make sure the customer is happy.",
  },
  {
    name: "KAG Pet",
    title: "",
    image: "https://images.unsplash.com/photo-1601455763557-db1bea8a9a5a?w=640",
    text: "Excellent communication and service. The team help me fix all the problems and even made a lot sweet short instruction videos. I have to mention they offer the best service at the most reasonable price. Thank you for the hard work and the special rate. Highly recommended!",
  },
  {
    name: "Box Chois",
    title: "",
    image: "https://images.unsplash.com/photo-1544725176-7c40e5a71c5e?w=640",
    text: "TaskerArmy was the best option for our custom box development. We received the best support and guidance in every step of the project. What we like the most was their professionalism and way they involved in the project. Super recommended.",
  },
];
---

<Container>
  <div class="mt-24">
    <h2 class="text-center text-4xl font-black lg:text-5xl lg:tracking-tight">
      What our <span class="text-[color:--primary-color]">customers</span> say
    </h2>
    <p class="mt-4 text-center text-lg text-slate-600">
      We’re one of the official top 10 world-ranked expert teams.
    </p>
  </div>
</Container>

<div class="relative mt-10 overflow-x-clip">
  <div
    class="bg-gradient-radial absolute -top-10 right-1/3 -z-10 h-96 w-96 from-indigo-100 blur-2xl"
  >
  </div>
  <div
    class="bg-gradient-radial absolute top-10 right-1/3 -z-10 h-96 w-96 translate-x-2/3 from-purple-100 blur-2xl"
  >
  </div>
  <div class="group relative gap-10 overflow-hidden py-5 md:flex">
    <div
      class="md:motion-safe:animate-marquee flex w-auto min-w-full shrink-0 snap-x snap-mandatory flex-nowrap items-stretch gap-10 overflow-x-auto px-5 py-5"
    >
      {testimonials.map((item) => <Review {...item} />)}
    </div>
    <!--  ↓↓ Shadow DOM to make the animation smooth (clone) ↓↓ -->
    <div
      class="md:motion-safe:animate-marquee hidden min-w-full shrink-0 items-center gap-10 md:flex md:motion-reduce:hidden"
    >
      {testimonials.map((item) => <Review {...item} />)}
    </div>
  </div>
</div>
