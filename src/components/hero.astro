---
import { Picture } from "astro:assets";
import heroImage from "../assets/shugert/Marketing-Analytics.png";
import Link from "@components/ui/link.astro";
import Container from "@components/container.astro";
---

<div class="overflow-x-clip">
  <Container>
    <section class="flex flex-col items-stretch justify-evenly md:flex-row">
      <div class="place-self-center md:p-5">
        <h1 class="text-md mb-6 font-semibold tracking-tight text-black">
          Transforming Digital Marketing With Artificial Intelligence
        </h1>
        <h1 class="text-4xl font-extrabold lg:text-6xl">
          Marketing Analytics customized to your business needs
        </h1>
        <p class="mt-4 max-w-xl text-lg text-black lg:text-xl">
          At <strong>Shugert</strong>, we have the appropriate dissemination and
          measurement tools so that your product or service reaches all possible
          audiences.
        </p>

        <div class="mt-6 flex justify-center space-x-4 md:justify-start">
          <a href="/shopify-experts" aria-label="View Our Services">
            <button
              class="group relative inline-flex h-14 items-center justify-center overflow-hidden rounded-4xl bg-white font-semibold shadow-md hover:shadow-lg focus:ring-2 focus:ring-gray-300"
            >
              <div
                class="inline-flex h-14 translate-y-0 items-center justify-center px-8 text-lg text-black transition-transform duration-500 group-hover:-translate-y-[150%]"
              >
                Free Consultation
              </div>
              <div
                class="absolute inline-flex h-14 w-full translate-y-[100%] items-center justify-center text-neutral-50 transition-transform duration-500 group-hover:translate-y-0"
              >
                <span
                  class="absolute h-full w-full translate-y-full scale-y-0 skew-y-10 bg-[#044080] transition-transform duration-500 group-hover:translate-y-0 group-hover:scale-150"
                ></span>
                <span class="z-10 text-lg">Let's go</span>
              </div>
            </button>
          </a>
        </div>
      </div>
      <div class="mt-10 place-self-center md:mt-0">
        <Picture
          src={heroImage}
          alt="Services"
          format={"webp"}
          loading="eager"
          class="h-auto lg:max-w-lg"
        />
      </div>
    </section>
  </Container>
</div>
