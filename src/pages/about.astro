---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
import Link from "@components/ui/link.astro";
import EmployeeImg from "../assets/employee.jpg";
import Logos from "@components/logos.astro";
import { Icon } from "astro-icon/components";
import Cta from "@components/cta.astro";
import Image from "astro/components/Image.astro";

import AboutUsBanner from "@assets/shugert/AboutUs.png";
import AboutUsEyeClosed from "@assets/shugert/aboutUS_eye_closed.png";
import AboutUsEyeOpen from "@assets/shugert/aboutUS_eye_open.png";

// Filter team entries with 'draft: false' & date before current date
const publishedTeamMembers = await getCollection("team", ({ data }) => {
  return !data.draft && data.publishDate < new Date();
});
---

<Layout title="About Us" footerMargin={false}>
  <Container>
    <section class="flex flex-col items-stretch md:m-4 md:flex-row md:p-4">
      <div class="place-self-center md:p-5">
        <h1 class="text-5xl font-bold lg:text-7xl">
          We produce creative content & concrete results
        </h1>
        <p class="mt-4 max-w-xl text-lg text-black lg:text-xl">
          We are a family of creators, graphic designers, writers, illustrators,
          coders, animators, data scientists, digital marketing specialists, and
          content generators. We create storytelling designed for your business
          and a focused digital marketing strategy: this is the compass to find
          your audience.
        </p>
      </div>
      <div class="mt-10 place-self-center md:mt-0">
        <Picture
          src={AboutUsBanner}
          alt="About Us Banner"
          formats={["avif", "webp"]}
          loading="eager"
          class="h-auto lg:max-w-xl"
        />
      </div>
    </section>
  </Container>

  <div class="mt-20 flex items-center justify-center bg-[#BBE1FA] p-8">
    <Container>
      <section class="flex flex-col items-stretch md:m-4 md:flex-row md:p-4">
        <div class="group place-self-center md:mt-0 md:mr-10">
          <Picture
            src={AboutUsEyeClosed}
            alt="About Us Eye Closed"
            formats={["avif", "webp"]}
            loading="eager"
            class="block h-auto group-hover:hidden lg:max-w-xl"
          />
          <Picture
            src={AboutUsEyeOpen}
            alt="About Us Eye Open"
            formats={["avif", "webp"]}
            loading="eager"
            class="hidden h-auto group-hover:block lg:max-w-xl"
          />
        </div>
        <div class="mt-10 place-self-center md:mt-0 md:p-5">
          <h1 class="text-md mb-2 font-semibold tracking-tight text-black">
            What do we do?
          </h1>
          <h1 class="text-2xl font-bold tracking-tight text-black">
            Platform, content & distribution
          </h1>
          <p class="mx-auto mt-4 max-w-md text-lg text-black/70">
            One solid streamlined process that starts with a stable, fast and
            responsive website, a creative team on high quality custom content
            and a dedicated team for distribution, SEO/ SEM, organic growth,
            newsletters, etc…. the whole thing.
          </p>
          <div class="mt-5 flex">
            <Link href="/portfolio">Explore our capabilities</Link>
          </div>
        </div>
      </section>
    </Container>
  </div>

  <!-- ! -->

  <Container>
    <div class="mt-24">
      <h2 class="text-center text-4xl lg:text-5xl lg:tracking-tight">
        Core <span class="font-bold text-indigo-600">Team</span>
      </h2>
      <p class="mt-4 text-center text-lg text-slate-600">
        Astroship is built by these awesome individuals.
      </p>
    </div>

    <div class="mx-auto mt-12 grid gap-10 md:grid-cols-4">
      {
        publishedTeamMembers.map((teamMemberEntry) => (
          <div class="group">
            <div class="aspect-square w-full">
              <Picture
                src={teamMemberEntry?.data?.avatar?.src}
                alt={teamMemberEntry?.data?.avatar?.alt || "Team Member"}
                loading="lazy"
                width={400}
                height={400}
                formats={["avif", "webp"]}
                class="h-full w-full rounded bg-white object-cover transition group-hover:-translate-y-1 group-hover:shadow-xl"
              />
            </div>

            <div class="mt-4 text-center">
              <h2 class="text-lg text-gray-800">{teamMemberEntry.data.name}</h2>
              <h3 class="text-sm text-slate-500">
                {teamMemberEntry.data.title}
              </h3>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</Layout>
