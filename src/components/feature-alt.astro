---
import { Picture } from "astro:assets";
import FeatureImg1 from "../assets/shugert/custom-machine-learning.png";
---

<section
  class="mt-4 flex flex-col-reverse items-stretch justify-evenly md:flex-row"
>
  <div class="mt-10 place-self-center md:mt-0">
    <Picture
      src={FeatureImg1}
      alt="Services"
      format={"webp"}
      loading="eager"
      class="h-auto lg:max-w-lg"
    />
  </div>
  <div class="place-self-center md:p-5">
    <h1 class="text-md mb-6 font-semibold tracking-tight text-black">
      How can we help you?
    </h1>
    <h1 class="text-4xl font-extrabold lg:text-6xl">
      Custom machine learning solutions for real-life problems
    </h1>
    <p class="mt-4 max-w-xl text-lg text-black lg:text-xl">
      Our machine learning team has helped 20+ top companies solve critical
      business problems with practical machine learning solutions
    </p>
  </div>
</section>
