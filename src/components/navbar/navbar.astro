---
// @ts-nocheck
import Container from "@components/container.astro";
import Link from "@components/ui/link.astro";
import Dropdown from "./dropdown.astro";
import { Picture } from "astro:assets";
import shugertLogo from "../../assets/shugert/shugert_2020_dark.png";
import { StickyHeader, Astronav, MenuItems, MenuIcon } from "astro-navbar";

const menuitems = [
  {
    title: "About Us",
    path: "/about",
  },
  {
    title: "Our Work",
    path: "/portfolio",
  },
  {
    title: "Services",
    path: "/our-services",
  },
  {
    title: "Learning Center",
    path: "/learning",
  },
  {
    title: "Blog",
    path: "/blog",
  },
  {
    title: "Shopify Experts",
    path: "/shopify-experts",
  },
];

const currentPath = Astro.url.pathname;
---

<StickyHeader
  class="sticky top-0 z-20 border-b transition-all"
  scrollY={130}
  defaultClass="py-5 border-transparent"
  activeClass="py-2 bg-white/80 border-gray-200 backdrop-blur-lg shadow-md"
>
  <Container>
    <div
      class="relative z-10 flex flex-col items-center justify-between lg:flex-row"
      transition:animate="none"
    >
      <Astronav>
        <div class="flex w-auto items-center justify-between lg:w-auto">
          <a
            style="width: 220px;"
            href="/"
            class="focus-visible:shadow-outline-indigo -ml-2 flex items-center rounded-full px-2 text-lg transition focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 focus-visible:outline-none"
          >
            <Picture
              src={shugertLogo}
              alt="Shugert Logo"
              formats={["avif", "webp"]}
              sizes="(max-width: 180px) 100vw, 50vw"
              widths={[180, shugertLogo.width]}
              loading="eager"
              fetchpriority="high"
              class="transition-transform duration-300 hover:scale-105"
            />
          </a>
          <div class="block lg:hidden">
            <MenuIcon
              class="h-6 w-6 text-gray-800 transition-transform duration-300 hover:scale-110"
            />
          </div>
        </div>
        <MenuItems class="mt-2 hidden w-full lg:mt-0 lg:flex">
          <ul class="flex w-full flex-col justify-center lg:flex-row lg:gap-8">
            {
              menuitems.map((item, index) => (
                <>
                  {item.children && (
                    <Dropdown
                      title={item.title}
                      children={item.children}
                      lastItem={index === menuitems.length - 1}
                    />
                  )}

                  {!item.children && (
                    <li>
                      <a
                        href={item.path}
                        class:list={[
                          "focus-visible:shadow-outline-indigo flex rounded-full py-2 text-base font-[800] transition focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 focus-visible:outline-none lg:px-3",
                          item.path === currentPath
                            ? "font-bold text-[#3282b8]"
                            : "text-[#222222] hover:text-[#3282b8]",
                        ]}
                      >
                        {item.title}
                      </a>
                    </li>
                  )}
                </>
              ))
            }
            <li>
              <a
                href="/contact"
                class="flex items-center justify-center rounded-full bg-[#3282b8] px-6 py-2 text-sm font-semibold text-white transition hover:bg-[#000] focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 focus-visible:outline-none"
              >
                Contact Us
              </a>
            </li>
          </ul>
        </MenuItems>
      </Astronav>
    </div>
  </Container>
</StickyHeader>
