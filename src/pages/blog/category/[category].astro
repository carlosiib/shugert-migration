---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";

import { Picture } from "astro:assets";

import Contactform from "@components/contactform.astro";

export async function getStaticPaths() {
  const blogs = await getCollection("blog");
  const categories = Array.from(
    new Set(blogs.map((post) => post.data.category))
  );

  return categories.map((category) => ({
    params: { category },
    props: {
      category,
      blogs: blogs.filter((post) => post.data.category === category),
    },
  }));
}

const { category, blogs } = Astro.props;
---

<Layout
  title={`Category: ${category}`}
  description={`Explore posts in the ${category} category on Shugert's blog. Stay informed with the latest insights and updates.`}
  footerMargin={false}
>
  <section class="bg-[#F9F9FA] py-6">
    <Container>
      <header class="p-10 text-center">
        <h1 class="text-3xl font-extrabold sm:text-4xl md:text-5xl">
          Posts in category: {category}
        </h1>
        <p class="mt-4 text-lg text-gray-700">
          Discover insightful articles and updates in the {category} category.
        </p>
      </header>

      <ul class="grid gap-10 sm:grid-cols-2 md:grid-cols-3 lg:gap-16">
        {
          blogs.map((post, index) => (
            <li class="group overflow-hidden rounded-lg shadow-md transition-shadow duration-300 hover:shadow-lg">
              <a
                href={`/blog/${post.slug}`}
                class="block h-full"
                aria-label={`Read more about ${post.data.title}`}
              >
                <div class="relative">
                  {post.data.image.src ? (
                    <Picture
                      formats={["avif", "webp"]}
                      src={post.data.image.src}
                      alt={
                        post.data.image.alt || `Image for ${post.data.title}`
                      }
                      sizes="(max-width: 800px) 100vw, 800px"
                      width={800}
                      height={600}
                      loading={index <= 2 ? "eager" : "lazy"}
                      decoding={index <= 2 ? "sync" : "async"}
                      class="h-48 w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      transition:name={`post-img-${post.slug}`}
                    />
                  ) : (
                    <div class="flex h-48 w-full items-center justify-center bg-gray-200 text-gray-500">
                      <span class="text-lg font-semibold">
                        No Image Available
                      </span>
                    </div>
                  )}

                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
                </div>

                <div class="p-4">
                  <span class="text-xs font-medium tracking-wider text-blue-400 uppercase">
                    {post.data.category}
                  </span>

                  <h2 class="mt-2 text-xl leading-snug font-semibold tracking-tight text-gray-800 transition-colors duration-300 group-hover:text-blue-500">
                    {post.data.title}
                  </h2>

                  <div class="mt-3 flex gap-2 text-sm text-gray-500">
                    <time datetime={post.data.publishDate.toISOString()}>
                      {post.data.publishDate.toDateString()}
                    </time>
                  </div>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <Contactform />
</Layout>
