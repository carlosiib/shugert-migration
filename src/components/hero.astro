---
import { Picture } from "astro:assets";
import heroImage from "../assets/shugert/Marketing-Analytics.png";
import Link from "@components/ui/link.astro";
import Container from "@components/container.astro";
---

<div class="overflow-x-clip">
  <Container>
    <main class="relative grid place-items-center lg:grid-cols-5">
      <div class="mt-10 max-w-sm place-self-start md:max-w-max lg:col-span-2">
        <hgroup>
          <h3 class="text-start text-sm [text-wrap:balance] text-slate-600">
            Transforming Digital Marketing With Artificial Intelligence
          </h3>
          <h1
            class="text-xl font-black lg:text-start lg:text-3xl lg:tracking-tight"
          >
            Marketing Analytics customized to your business needs
          </h1>
          <h2
            class="mt-4 max-w-lg text-start text-lg [text-wrap:balance] text-slate-600"
          >
            At <strong>Shugert</strong>, we have the appropriate dissemination
            and measurement tools so that your product or service reaches all
            possible audiences.
          </h2>
        </hgroup>
        <div
          class="mt-6 flex flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start"
        >
          <Link
            href="https://web3templates.com/templates/astroship-pro-astro-saas-website-template"
            target="_blank"
            class="flex items-center justify-center gap-1"
            rel="noopener"
          >
            Free Consultation
          </Link>
        </div>
      </div>
      <div class="py-3 lg:col-span-3 lg:-mr-44">
        <Picture
          src={heroImage}
          alt="Astronaut in the air"
          formats={["avif", "webp"]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          widths={[240, 540, 720, heroImage.width]}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </main>
  </Container>
</div>
