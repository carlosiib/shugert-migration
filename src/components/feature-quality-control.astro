---
import Container from "@components/container.astro";
import Review from "@components/review.astro";
import Badge from "./ui/badge.astro";
import Picture from "astro/components/Picture.astro";
import icon1 from "../assets/shugert/Paso1.png";
import icon2 from "../assets/shugert/Paso2.png";
import icon3 from "../assets/shugert/Paso3.png";
import icon4 from "../assets/shugert/Paso4.png";
import icon5 from "../assets/shugert/Paso5.png";

const benefitsExplained = [
  {
    src: icon1,
    title: "01. Initial Research",
    text: "We learn all about what your company is about including your long term goals and challenges.",
  },
  {
    src: icon2,
    title: "02. Ideation phase",
    text: "We'll analyze which channels and approach you're currently using to market your company.",
  },
  {
    src: icon3,
    title: "03. Campaign launch",
    text: "Next, we lay the foundation of your marketing efforts by setting up the appropriate systems to maximize your budget.",
  },
  {
    src: icon4,
    title: "04. Revision",
    text: "Using the channels that work for your company, we'll develop campaigns that attract, convert, close, and delight your customers.",
  },
  {
    src: icon5,
    title: "05. Optimization",
    text: "Each month we'll review what's working and what needs to be optimized.",
  },
];
---

<div class="mt-24 text-center">
  <h1 class="text-md mb-2 font-semibold tracking-tight text-black">
    A good production process makes for better quality control
  </h1>
  <h2 class="my-6 text-4xl font-extrabold text-gray-800">
    Our typical custom process consists of:
  </h2>
</div>

<div class="my-10 grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-5">
  {
    benefitsExplained.map((benefitExplained, index) => (
      <div class="flex flex-col items-center p-6 text-center">
        <Picture
          src={benefitExplained.src}
          alt={benefitExplained.title || `Card image ${index + 1}`}
          class="h-auto max-w-sm object-contain mb-4"
          loading="lazy"
          height={100}
        />
        <h3 class="mb-4 text-xl font-bold text-gray-800">
          {benefitExplained.title}
        </h3>
        <p class="text-gray-600">{benefitExplained.text}</p>
      </div>
    ))
  }
</div>
