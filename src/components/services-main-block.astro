---
import Container from "@components/container.astro";
import Layout from "@layouts/Layout.astro";
import { Image } from "astro:assets";
import servicesImage from "/src/assets/shugert/Services_Shugert.png";

import type { ImageMetadata } from "astro";

const { sectionInfo, imageLoad } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/shugert/*.{jpeg,jpg,png,gif}"
);

if (!images[sectionInfo.image])
  throw new Error(
    `"${sectionInfo.image}" does not exist in glob: "src/assets/shugert/*.{jpeg,jpg,png,gif}"`
  );
---

<Container>
  <main
    class="relative grid place-items-center justify-items-center pt-[45px] pb-[45px] lg:grid-cols-5"
  >
    <div class="mt-10 place-self-start md:max-w-max lg:col-span-2">
      <hgroup>
        <h3 class="text-start text-sm [text-wrap:balance]">
          {sectionInfo.category}
        </h3>
        <h1 class="text-5xl font-bold lg:text-start lg:tracking-tight">
          {sectionInfo.header}
        </h1>
        <h2 class="mt-4 text-start text-xl lg:[text-wrap:balance]">
          {sectionInfo.mainText}
        </h2>
      </hgroup>

      <ul class="mt-[48px] grid grid-cols-2 gap-9">
        {
          sectionInfo.grid.map((value) => (
            <li>
              <h4 class="text-xl font-medium">{value.title}</h4>
              <p>{value.text}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mx-1 max-w-[600px] py-3 lg:col-span-3">
      <Image
        src={images[sectionInfo.image]()}
        alt={sectionInfo.imageAlt}
        sizes="(max-width: 600px) 100vw, 50vw"
        widths={[240, 540, 720]}
        loading={imageLoad}
        fetchpriority="high"
      />
    </div>
  </main>
</Container>
